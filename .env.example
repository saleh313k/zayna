# Copy this file to .env and replace the required values with private values.
# Do not commit .env.

# Required: use a strong unique password compatible with SQL Server's password policy.
DB_PASSWORD=replace_with_a_strong_unique_password
DB_PORT=1433

# Required: generate a private random secret of at least 32 characters.
JWT_SECRET_KEY=replace_with_a_private_random_secret_at_least_32_characters
JWT_ISSUER=ZAYNA.API
JWT_AUDIENCE=ZAYNA.Client
JWT_EXPIRY_HOURS=24

ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
FRONTEND_PORT=3000

# This URL is embedded into the frontend at build time.
# For local development, the browser calls the API on localhost:5000.
VITE_API_URL=http://localhost:5000/api
