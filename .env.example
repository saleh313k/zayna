# Copy this file to .env and replace the required values with private values.
# Do not commit .env.

# Required: use a strong unique password compatible with SQL Server's password policy.
DB_PASSWORD=
DB_PORT=1433

# Required: generate a private random secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ISSUER=ZAYNA.API
JWT_AUDIENCE=ZAYNA.Client
JWT_EXPIRY_HOURS=24

# Required: Google OAuth "Web application" client id (Google Cloud Console > APIs & Services > Credentials).
# Add your frontend origin (e.g. http://localhost:3000, https://your-domain) under "Authorised JavaScript origins".
# This is a public identifier (not a secret); the same value is used by the API and the frontend build.
GOOGLE_CLIENT_ID=

# Email of the platform administrator. This person signs in with Google using this address and can
# approve salons. Leave empty to create no admin.
ADMIN_EMAIL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
FRONTEND_PORT=3000

# This URL is embedded into the frontend at build time.
# For local development, the browser calls the API on localhost:5000.
VITE_API_URL=http://localhost:5000/api
