# ZAYNA production configuration.  Copy to ".env" ON THE SERVER ONLY:   cp .env.production.example .env
# Then edit it and run:  chmod 600 .env
#
# RULES: no spaces around "=", no quotes, no "$" and no ";" inside values. Every value below is an EXAMPLE.
# NEVER commit the real .env (it is git-ignored).

# --- Public address -----------------------------------------------------------------------------------------
# The domain you will point at the server (DNS A/AAAA record) - without https://
DOMAIN=zayna.example.com
# Email Let's Encrypt uses for certificate expiry notices
ACME_EMAIL=you@example.com

# --- Database ----------------------------------------------------------------------------------------------
# SQL Server 'sa' password: 12+ chars with upper, lower, digit and symbol (SQL Server enforces complexity).
# Used only for administration and backups, never by the application.
DB_SA_PASSWORD=ChangeMe-Sa-Password-1!x
# Password of the application's own database login. 16+ chars, ONLY letters, digits, "." "_" "-"
# Generate one:  openssl rand -hex 24
DB_APP_PASSWORD=change-me-0123456789abcdef0123456789abcdef
# SQL Server memory cap in MB (leave 1536 on a 4 GB server)
DB_MEMORY_LIMIT_MB=1536

# --- Application secrets -----------------------------------------------------------------------------------
# Signs login tokens. Generate a NEW one for production:  openssl rand -base64 48
# (If the generated value contains "$" or ";" generate again.)
JWT_SECRET_KEY=replace-with-48-random-bytes-in-base64-do-not-reuse-the-dev-key
JWT_ISSUER=ZAYNA.API
JWT_AUDIENCE=ZAYNA.Client
JWT_EXPIRY_HOURS=24

# Google OAuth "Web application" client id. In Google Cloud Console add https://YOUR-DOMAIN under
# "Authorised JavaScript origins" and publish the consent screen ("In production") so any user can sign in.
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# The one email that gets the Admin role (signs in with Google). Leave empty to create no admin.
ADMIN_EMAIL=owner@example.com

# --- Optional ----------------------------------------------------------------------------------------------
# Salon-local time zone used for booking times
BOOKING_TIMEZONE=Asia/Muscat
# Image tag, set by deploy/scripts/deploy.sh (git commit id). Leave unset when deploying by hand.
# APP_VERSION=local
# Backups: how many days to keep local copies, and (optional) an rclone remote for off-server copies,
# e.g. "b2:zayna-backups" - configure the remote with `rclone config` first. Leave empty to skip off-server copies.
BACKUP_KEEP_DAYS=14
BACKUP_RCLONE_REMOTE=
