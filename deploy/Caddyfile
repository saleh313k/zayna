# Caddy: the only publicly exposed service. It obtains and renews the HTTPS certificate automatically
# (Let's Encrypt) as long as DNS for {$DOMAIN} points at this server and ports 80/443 are reachable.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}

	# API: forwarded to the container on the private Docker network. Caddy sets X-Forwarded-For/Proto itself.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Health endpoints (for uptime monitors): /health/live (process) and /health/ready (process + database).
	handle /health/* {
		reverse_proxy api:8080
	}

	# Built assets are content-hashed by Vite, so they can be cached for a year.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app: unknown paths fall back to index.html (client-side routing).
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
